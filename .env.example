# ----------------------------------------------------------------- Banco ----
# Connection string do Neon (projeto "karate"). Console › Connection Details.
DATABASE_URL="postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------- Mercado Pago ----
# Credenciais › Access Token. Use o de TESTE enquanto valida o fluxo.
MERCADOPAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-xxxxxxxx-000000000"
# URL pública que recebe as notificações (ngrok em dev, domínio em produção).
MERCADOPAGO_WEBHOOK_URL="https://seu-dominio.com/api/webhooks/mercadopago"
# Segredo da assinatura do webhook (Suas integrações › Webhooks).
# Sem ele a validação de assinatura é pulada — nunca deixe vazio em produção.
MERCADOPAGO_WEBHOOK_SECRET=""

# ----------------------------------------------------------------- Stripe ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# -------------------------------------------------------------- Aplicação ---
APP_URL="http://localhost:3000"
# Mensalidade em centavos (R$ 50,00).
VALOR_MENSALIDADE_CENTAVOS="1"
# Mesmo valor exposto ao navegador (telas de mensalidade).
NP_MENSALIDADE_CENTAVOS="1"
# Segredo que assina o cookie de sessão (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="troque-por-uma-string-longa-e-aleatoria-de-48-bytes"

# Segredo do cron da Vercel (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET="troque-por-uma-string-longa-e-aleatoria"
